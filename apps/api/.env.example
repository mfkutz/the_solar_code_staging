# --- The Solar Code API ---
# Copy to .env (gitignored) and fill in. In production (Railway) these come from
# the platform's env vars, not this file.

# Port the server listens on (Railway sets this automatically in prod).
PORT=4100

# 'development' or 'production'. In prod the auth cookie becomes SameSite=None;Secure.
NODE_ENV=development

# Comma-separated allowlist of origins that may call the API (the SPA).
# Leave empty to allow any origin in local dev.
CORS_ORIGIN=http://localhost:3000

# Secret used to sign session JWTs. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres connection string. Local dev points at the Docker Compose Postgres
# (host port 5435). In production (Railway) this comes from the platform.
DATABASE_URL="postgresql://solarcode:solarcode_dev@localhost:5435/thesolarcode_dev?schema=public"

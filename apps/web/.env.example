# Base URL of the backend API.
# Local dev: the Express server from apps/api (docker compose + npm run dev).
# Production: the Railway URL of the API.
VITE_API_URL=http://localhost:4100

# Stripe Payment Links (no backend required).
# Leave empty to preview the report flow locally without paying.
# On staging/prod: paste the Stripe Payment Link URL for each product.
# The link's "after payment" redirect must point to the same origin + /codigo/informe
VITE_STRIPE_FULL_REPORT=
VITE_STRIPE_PAREJA=
VITE_STRIPE_GRUPAL_5=
VITE_STRIPE_GRUPAL_8=
